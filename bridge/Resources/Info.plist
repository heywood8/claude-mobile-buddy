<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleExecutable</key>
	<string>cmbridge</string>
	<key>CFBundleIdentifier</key>
	<string>dev.heywood8.cmbridge</string>
	<key>CFBundleName</key>
	<string>Claude Buddy (bridge)</string>
	<!-- What Finder and the Bluetooth entry in Privacy & Security show. The executable inside
	     stays `cmbridge`, because that is the command you type. -->
	<key>CFBundleDisplayName</key>
	<string>Claude Buddy (bridge)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.7.0</string> <!-- x-release-please-version -->
	<key>CFBundleVersion</key>
	<string>0.7.0</string> <!-- x-release-please-version -->
	<key>LSMinimumSystemVersion</key>
	<string>13.0</string>

	<!-- No Dock icon, no menu bar. This is a background agent, not an app you switch to. -->
	<key>LSUIElement</key>
	<true/>

	<!-- The whole reason the bundle exists. A bare command-line binary has no TCC identity of
	     its own and inherits Bluetooth permission from whatever launched it; under launchd
	     there is nothing to inherit from, so the radio silently never appears. -->
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Claude Buddy talks to your phone over Bluetooth so you can approve Claude Code permission requests from it.</string>
</dict>
</plist>
